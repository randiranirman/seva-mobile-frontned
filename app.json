{
  "expo": {
    "name": "SevaMobileAppOwner",
    "slug": "SevaMobileAppOwner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "sevamobileappowner",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.randira.sevamobileappowner",
      "adaptiveIcon": {
        "backgroundColor": "#FFC20E",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon-32.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC20E",
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ac4fafe6-681b-403c-8e39-09d0fbb5f03c"
      }
    },
    "owner": "randiranirman"
  }
}
